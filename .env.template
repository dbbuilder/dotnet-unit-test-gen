# ========================================
# AI Provider Configuration
# ========================================

# OpenAI (RECOMMENDED - GPT-4o mini has best quality/cost balance)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude (Alternative - 74% cheaper than GPT-4 Turbo)
# Get key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini (Alternative - 97% cheaper than GPT-4 Turbo)
# Get key at: https://makersuite.google.com/app/apikey
# GOOGLE_API_KEY=your-google-api-key-here

# GitHub Copilot (optional - uses OpenAI as fallback)
# GITHUB_TOKEN=your-github-token-here

# ========================================
# Provider Selection (NEW)
# ========================================

# Default provider: openai | claude | gemini
# DEFAULT_PROVIDER=openai

# Model overrides (optional)
# For OpenAI:
# PRIMARY_MODEL=gpt-4o-mini     # RECOMMENDED (best quality/cost)
# FALLBACK_MODEL=gpt-3.5-turbo
# SIMPLE_MODEL=gpt-4o-mini

# ========================================
# Test Generation Settings
# ========================================

MAX_TOKENS=2000
TEMPERATURE=0.2
TEST_FRAMEWORK=xunit

# ========================================
# Rate Limiting
# ========================================

MAX_REQUESTS_PER_MINUTE=50
RETRY_ATTEMPTS=3
